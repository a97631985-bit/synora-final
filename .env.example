GEMINI_API_KEY=your_gemini_api_key_here
SYNORA_PORT=5001
SYNORA_SECRET=change-this-to-a-long-random-value
# Postgres connection string (Neon / Supabase / Vercel Postgres). Required on Vercel.
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Set to 1 only on Vercel (disables connection pooling for short-lived functions)
SYNORA_SERVERLESS=1
